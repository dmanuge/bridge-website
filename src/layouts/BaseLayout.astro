---
import Analytics from "@/components/Analytics.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { siteSettings } from "@/data/site";
import { siteUrl } from "@/lib/site";
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Site header color treatment.
   * - default: light chrome over dark heroes; frosted glass after scroll
   * - inverted: dark chrome on solid ivory (sticky)
   * - over-hero: light chrome over full-bleed heroes; frosted glass after scroll
   */
  headerVariant?: "default" | "inverted" | "over-hero";
}

const {
  title,
  description,
  image = "/images/brand/hotel-construction-sunrise.png",
  noindex = false,
  schema,
  headerVariant = "default",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const socialImage = new URL(image, siteUrl).toString();
const fullTitle = title === "Bridge" ? title : `${title} | Bridge`;
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteSettings.companyName,
  legalName: siteSettings.legalName,
  url: siteUrl,
  logo: new URL("/logos/bridge-logo-navy.png", siteUrl).toString(),
  email: siteSettings.supportEmail,
};
const schemas = [
  organization,
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#04112A" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link
      rel="preload"
      href="/fonts/dm-sans-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/logos/bridge-arch-navy.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bridge" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{fullTitle}</title>
    {
      schemas.map((item) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(item)}
        />
      ))
    }
    {/* SPA-style navigation so version/home switches avoid full reloads */}
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader variant={headerVariant} />
    {
      /*
      No transition:animate on main — it creates a containing block that breaks
      position:fixed hero media (version-3 video/overlay would scroll with the page).
    */
    }
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <Analytics />
    <script>
      /**
       * Hero autoplay that re-runs after ClientRouter navigations.
       * Poster paints first; video starts loading only after the page is live
       * so multi‑MB clips do not block the version switch.
       */
      let visibilityBound = false;

      function initHeroVideos() {
        document
          .querySelectorAll<HTMLElement>("[data-hero]")
          .forEach((hero) => {
            const video =
              hero.querySelector<HTMLVideoElement>("[data-hero-video]");
            if (!video) {
              window.requestAnimationFrame(() => hero.classList.add("is-live"));
              return;
            }
            if (video.dataset.heroInit === "1") return;
            video.dataset.heroInit = "1";

            video.muted = true;
            video.defaultMuted = true;
            video.playsInline = true;
            video.setAttribute("playsinline", "");
            video.setAttribute("webkit-playsinline", "");

            const reveal = () => {
              video.classList.add("is-ready");
              hero.classList.add("is-live");
            };

            const tryPlay = () => {
              const playPromise = video.play();
              if (playPromise && typeof playPromise.then === "function") {
                playPromise.then(reveal).catch(() => {
                  /* keep poster until autoplay is allowed */
                });
              }
            };

            video.addEventListener("loadeddata", reveal);
            video.addEventListener("canplay", () => {
              reveal();
              tryPlay();
            });
            video.addEventListener("playing", reveal);

            // Defer full buffer until after navigation paint.
            if (video.preload !== "auto") {
              video.preload = "auto";
            }
            if (video.readyState >= 2) {
              reveal();
              tryPlay();
            } else {
              video.load();
              tryPlay();
            }

            // Do not wait forever on large files for copy choreography.
            window.setTimeout(() => hero.classList.add("is-live"), 900);

            if (!visibilityBound) {
              document.addEventListener("visibilitychange", () => {
                if (document.hidden) return;
                document
                  .querySelectorAll<HTMLVideoElement>("[data-hero-video]")
                  .forEach((v) => {
                    void v.play().catch(() => undefined);
                  });
              });
              visibilityBound = true;
            }
          });
      }

      document.addEventListener("astro:page-load", initHeroVideos);
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.7rem 1rem;
    background: var(--white);
    color: var(--navy-950);
    font-weight: 700;
    transform: translateY(-150%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  @media (max-width: 56.25rem) {
    body {
      --gutter: 1.25rem;
      --section-space-compact: clamp(3rem, 8vw, 4rem);
    }
  }
</style>
