---
import Action from "@/components/Action.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { applicationHref } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  source: string;
  financing?: string;
}

const {
  title = "Tell us what you’re financing.",
  description = "Choose what fits and we’ll take it from there.",
  source,
  financing,
} = Astro.props;

const goals = [
  {
    label: "Build",
    icon: '<rect x="4" y="8" width="12" height="8"/><path d="M4 8l6-4 6 4"/>',
  },
  {
    label: "Improve",
    icon: '<path d="M4 16L16 4M8 4h8v8"/>',
  },
  {
    label: "Acquire",
    icon: '<circle cx="7" cy="10" r="3.2"/><path d="M10 10h7M14 10v3"/>',
  },
  {
    label: "Refinance",
    icon: '<path d="M4 8a6 6 0 0 1 11-2M16 12a6 6 0 0 1-11 2"/><path d="M15 3v3h-3M5 17v-3h3"/>',
  },
  {
    label: "Inventory",
    icon: '<path d="M4 7l6-3 6 3v6l-6 3-6-3zM4 7l6 3 6-3M10 10v6"/>',
  },
  {
    label: "Orders",
    icon: '<rect x="5" y="3" width="10" height="14" rx="1"/><path d="M8 8h4M8 11h4"/>',
  },
  {
    label: "Working capital",
    icon: '<ellipse cx="10" cy="6.5" rx="5" ry="2.5"/><path d="M5 6.5v7c0 1.4 2.2 2.5 5 2.5s5-1.1 5-2.5v-7"/><path d="M5 10c0 1.4 2.2 2.5 5 2.5s5-1.1 5-2.5"/>',
  },
];
---

<section class="final-cta">
  <div class="final-cta__inner">
    <SectionHeading
      eyebrow="Get started"
      title={title}
      description={description}
    />
    <div class="final-cta__actions">
      <div class="final-cta__goals" aria-label="Common financing goals">
        {
          goals.map((goal) => (
            <span>
              <svg
                viewBox="0 0 20 20"
                aria-hidden="true"
                set:html={goal.icon}
              />
              {goal.label}
            </span>
          ))
        }
      </div>
      <Action
        href={applicationHref(source, financing)}
        arrow
        analytics="application_exit"
        analyticsLabel={source}>Get Started</Action
      >
    </div>
    <p class="disclosure">
      All financing is subject to application, credit review, and underwriting.
    </p>
  </div>
</section>

<style>
  .final-cta {
    padding-block: var(--section-space-compact);
    background: var(--surface-page);
  }

  .final-cta__inner {
    width: 100%;
    padding-inline: var(--gutter);
  }

  .final-cta__actions {
    display: grid;
    align-items: center;
    grid-template-columns: 1fr auto;
    gap: 1.5rem;
  }

  .final-cta__goals {
    display: flex;
    flex-wrap: wrap;
    margin-top: 1.25rem;
    gap: 0.5rem 0.375rem;
  }

  .final-cta__goals span {
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 0.4375rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    color: var(--text-primary);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .final-cta__goals span:hover {
    border-color: var(--border-default);
    background: var(--surface-raised);
  }

  .final-cta__goals svg {
    width: 1.0625rem;
    height: 1.0625rem;
    fill: none;
    stroke: var(--navy-950);
    stroke-width: 1.6;
  }

  .final-cta__actions :global(.button) {
    margin-top: 1.25rem;
    background: var(--surface-action);
  }

  .final-cta .disclosure {
    margin: 1rem 0 0;
  }

  @media (max-width: 37.5rem) {
    .final-cta__actions {
      grid-template-columns: 1fr;
    }

    .final-cta__actions :global(.button) {
      width: 100%;
      margin-top: 0;
    }
  }
</style>
