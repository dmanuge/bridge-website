---
import { paths } from "@/data/site";
import ResponsiveImage from "@/components/ResponsiveImage.astro";

const doorImages = [
  {
    src: "/images/two-doors/858ef286-b08c-4169-aeb2-55c1ee3b246e.png",
    alt: "Hotel financing opportunity",
  },
  {
    src: "/images/two-doors/a04e0f5f-047c-49c2-88c5-4b4333acdd1d.png",
    alt: "Consumer brand financing opportunity",
  },
];
const doorDescriptions = [
  "Direct lending for new construction and PIPs. Expert-led financing execution for other hotel needs.",
  "Direct financing for inventory, orders, receivables, working capital and acquisitions.",
];
const recentFinancings = [
  {
    category: "New Construction",
    result: "$75,000,000",
    role: "Bridge Direct Lending",
  },
  {
    category: "Inventory Financing",
    result: "$8,000,000",
    role: "Bridge Direct Lending",
  },
];
---

<section class="two-doors" aria-labelledby="two-doors-title">
  <h1 id="two-doors-title" class="sr-only">
    Financing for hotel owners and consumer brands
  </h1>
  {
    paths.map((path, index) => (
      <article class="door">
        <ResponsiveImage
          class="door__image"
          src={doorImages[index]!.src}
          alt={doorImages[index]!.alt}
          width={1600}
          height={1067}
          sizes="(max-width: 800px) 100vw, 50vw"
          loading={index === 0 ? "eager" : "lazy"}
          fetchpriority={index === 0 ? "high" : "auto"}
        />
        <div class="door__overlay" />
        <div class="door__content">
          <h2>{path.title}</h2>
          <p class="door__description">{doorDescriptions[index]}</p>
          <hr />
          <div class="door__result">
            <p class="door__label">Recent financing</p>
            <p class="door__category">{recentFinancings[index]!.category}</p>
            <p class="door__amount">{recentFinancings[index]!.result}</p>
            <p class="door__role">{recentFinancings[index]!.role}</p>
            <a
              href={`/${path.slug}`}
              class="door__button"
              aria-label={`Explore ${path.title}`}
              data-analytics="door_selection"
              data-analytics-label={path.slug}
            >
              Explore {path.title} <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>
    ))
  }
</section>

<style>
  .two-doors {
    display: grid;
    min-height: 43.125rem;
    background: var(--navy-950);
    grid-template-columns: 1fr 1fr;
  }

  .door {
    position: relative;
    min-width: 0;
    overflow: hidden;
  }

  .door + .door {
    border-left: 1px solid var(--inverse-line);
  }

  :global(.door__image),
  .door__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  :global(.door__image img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 70%;
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .door:nth-child(2) :global(.door__image img) {
    object-position: center;
  }

  .door:hover :global(.door__image img),
  .door:focus-within :global(.door__image img) {
    transform: scale(1.025);
  }

  .door__overlay {
    background: linear-gradient(
      180deg,
      var(--door-overlay-50) 0%,
      var(--door-overlay-42) 46%,
      var(--door-overlay-90) 100%
    );
  }

  .door__content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 43.125rem;
    flex-direction: column;
    justify-content: flex-end;
    padding: 8.125rem clamp(1.375rem, 3vw, 2.75rem) 3.25rem;
    color: var(--text-inverse);
  }

  .door__label,
  .door__category,
  .door__role {
    margin: 0;
  }

  .door h2 {
    max-width: 12ch;
    margin: 0 0 0.875rem;
    font-size: clamp(2rem, 3.2vw, 3rem);
    font-weight: 560;
    letter-spacing: -0.012em;
    line-height: 1.08;
  }

  .door__description {
    max-width: 38ch;
    margin: 0;
    color: var(--inverse-82);
    font-size: 0.84375rem;
    line-height: 1.65;
  }

  .door hr {
    width: 7.5rem;
    height: 1px;
    border: 0;
    margin: 1.375rem 0;
    background: var(--gold-rule);
  }

  .door__result {
    max-width: 32rem;
  }

  .door__label {
    color: var(--steel-light);
    font-size: 0.625rem;
    font-weight: 640;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .door__category {
    margin-top: 0.3125rem;
    font-size: 0.8125rem;
    font-weight: 640;
  }

  .door__amount {
    margin: 0.375rem 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3vw, 2.625rem);
    font-weight: 580;
    letter-spacing: -0.012em;
    line-height: 1.04;
  }

  .door__role {
    color: var(--steel-light);
    font-size: 0.625rem;
    font-weight: 680;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .door__button {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.625rem;
    min-height: 3rem;
    border: 1px solid var(--inverse-55);
    border-radius: 0.375rem;
    margin-top: 1.375rem;
    padding: 0.75rem 1.25rem;
    color: var(--text-inverse);
    font-size: 0.84375rem;
    font-weight: 660;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .door__button:hover {
    border-color: var(--white);
    background: var(--inverse-08);
  }

  @media (max-width: 56.25rem) {
    .two-doors {
      grid-template-columns: 1fr;
    }

    .door + .door {
      border-top: 1px solid var(--inverse-line);
      border-left: 0;
    }

    .door__content {
      height: 33.75rem;
      min-height: 33.75rem;
      padding-top: 6.875rem;
    }

    .door {
      height: 33.75rem;
    }
  }
</style>
