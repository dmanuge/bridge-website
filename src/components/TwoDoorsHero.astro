---
import { paths, proofPoints } from "@/data/site";
import ResponsiveImage from "@/components/ResponsiveImage.astro";

const doorImages = [
  {
    src: "/images/two-doors/f7ac3e21-bdf0-4528-a15e-f2ca14a0c3ef.png",
    alt: "Hotel financing opportunity",
  },
  {
    src: "/images/two-doors/08bc4260-b224-4358-86ae-04c150a2b660.png",
    alt: "Consumer brand financing opportunity",
  },
];
const doorDescriptions = [
  "New construction, PIPs, and expert-led execution for every other hotel need.",
  "Inventory, orders, receivables, working capital and acquisitions.",
];
const recentFinancings = [
  {
    category: "New construction",
    result: "$75,000,000",
    role: "Bridge Direct Lending",
  },
  {
    category: "Inventory financing",
    result: "$8,000,000",
    role: "Bridge Direct Lending",
  },
];
---

<section class="two-doors" aria-labelledby="two-doors-title">
  <div class="two-doors__rail">
    <h1 id="two-doors-title" class="two-doors__promise">
      Financing for hotel owners and consumer brands.
    </h1>
    <dl class="two-doors__proof">
      {
        proofPoints.map((point) => (
          <div class="two-doors__proof-item">
            <dt>{point.value}</dt>
            <dd>{point.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="two-doors__grid">
    {
      paths.map((path, index) => (
        <article class="door">
          <ResponsiveImage
            class="door__image"
            src={doorImages[index]!.src}
            alt={doorImages[index]!.alt}
            width={1600}
            height={1067}
            sizes="(max-width: 800px) 100vw, 50vw"
            loading={index === 0 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : "auto"}
          />
          <div class="door__overlay" />
          <div class="door__content">
            <h2>{path.title}</h2>
            <p class="door__description">{doorDescriptions[index]}</p>
            <div class="door__result">
              <p class="door__label">Recent financing</p>
              <p class="door__amount">{recentFinancings[index]!.result}</p>
              <p class="door__meta">
                {recentFinancings[index]!.category} &middot;{" "}
                {recentFinancings[index]!.role}
              </p>
            </div>
            <a
              href={`/${path.slug}`}
              class="door__button"
              aria-label={`Explore ${path.title}`}
              data-analytics="door_selection"
              data-analytics-label={path.slug}
            >
              Explore {path.title} <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .two-doors {
    display: flex;
    flex-direction: column;
    background: var(--navy-950);
  }

  /* Doors sit above the rail visually; the promise stays first in the DOM so the
     page still reads h1 then h2s. */
  .two-doors__grid {
    display: grid;
    min-height: 37.5rem;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    order: 1;
  }

  .two-doors__rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.75rem var(--gutter);
    border-top: 1px solid var(--inverse-line);
    background: var(--surface-brand);
    color: var(--text-inverse);
    column-gap: clamp(1.5rem, 4vw, 4rem);
    order: 2;
    row-gap: 1.25rem;
  }

  .two-doors__promise {
    max-width: 24ch;
    flex: 0 0 auto;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 1.7vw, 1.375rem);
    font-weight: 560;
    letter-spacing: -0.008em;
    line-height: 1.25;
  }

  /* Four even columns so the labels wrap on a shared rhythm instead of
     ragging out beside their numbers. */
  .two-doors__proof {
    display: grid;
    min-width: 0;
    margin: 0;
    column-gap: clamp(1.25rem, 2.6vw, 2.5rem);
    flex: 1 1 auto;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .two-doors__proof-item {
    display: grid;
    align-content: start;
    gap: 0.375rem;
  }

  .two-doors__proof dt {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 580;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
  }

  .two-doors__proof dd {
    max-width: none;
    margin: 0;
    color: var(--text-inverse-muted);
    font-size: var(--type-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  /* Wide desktop: size the stat columns to their content and spread them, so
     every label sits on one line. Narrower screens keep even columns and let
     the longest label wrap rather than overflow. */
  @media (min-width: 77.5rem) {
    .two-doors__proof {
      justify-content: space-between;
      grid-template-columns: repeat(4, max-content);
    }
  }

  .door {
    position: relative;
    min-width: 0;
    overflow: hidden;
  }

  /* No center divider - tapestry halves meet flush at the seam */
  .door + .door {
    border-left: 0;
  }

  :global(.door__image),
  .door__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  :global(.door__image img) {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    /* Left door: center the photo in the frame */
    object-position: center center;
    transform-origin: center center;
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* first-of-type / last-of-type: ignore any non-article siblings */
  .door:last-of-type :global(.door__image img) {
    /* Right door: keep the right edge of the photo in frame */
    object-position: right center;
    transform-origin: right center;
  }

  .door:hover :global(.door__image img),
  .door:focus-within :global(.door__image img) {
    transform: scale(1.025);
  }

  /* Two layers: a gentle vertical base, plus a wedge anchored under the copy.
     The wedge protects the type while the upper right of the artwork stays lit. */
  .door__overlay {
    background:
      linear-gradient(
        90deg,
        var(--door-wedge-90) 0%,
        var(--door-wedge-62) 30%,
        var(--door-wedge-20) 58%,
        var(--door-wedge-00) 78%
      ),
      linear-gradient(
        180deg,
        var(--door-base-66) 0%,
        var(--door-base-26) 36%,
        var(--door-base-44) 64%,
        var(--door-base-86) 100%
      );
  }

  .door__content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 37.5rem;
    flex-direction: column;
    justify-content: flex-end;
    padding: 8.125rem clamp(1.375rem, 3vw, 2.75rem) 3rem;
    color: var(--text-inverse);
  }

  .door__label,
  .door__amount,
  .door__meta {
    margin: 0;
  }

  .door h2 {
    max-width: 14ch;
    margin: 0 0 0.75rem;
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    font-weight: 560;
    letter-spacing: -0.012em;
    line-height: 1.08;
  }

  .door__description {
    max-width: 36ch;
    margin: 0;
    color: var(--inverse-82);
    font-size: var(--type-body-small);
    line-height: 1.62;
  }

  .door__result {
    max-width: 32rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--gold-rule);
  }

  .door__label {
    color: var(--text-inverse-muted);
    font-size: var(--type-label);
    font-weight: 640;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .door__amount {
    margin: 0.375rem 0 0.375rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.7vw, 2.375rem);
    font-weight: 580;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.012em;
    line-height: 1.04;
  }

  .door__meta {
    color: var(--inverse-82);
    font-size: var(--type-label);
    font-weight: 640;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* Primary action: solid, so the door CTA outranks the header button */
  .door__button {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.625rem;
    min-height: 3rem;
    border: 1px solid var(--white);
    border-radius: var(--radius-sm);
    margin-top: 1.5rem;
    padding: 0.75rem 1.25rem;
    background: var(--white);
    color: var(--navy-950);
    font-size: var(--type-body-small);
    font-weight: 660;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .door__button:hover {
    background: var(--inverse-80);
  }

  @media (max-width: 56.25rem) {
    .two-doors__grid {
      grid-template-columns: 1fr;
    }

    .door + .door {
      border-top: 1px solid var(--inverse-line);
      border-left: 0;
    }

    /* Stacked: show natural crop of each half rather than seam anchors */
    :global(.door__image img),
    .door:last-of-type :global(.door__image img) {
      object-position: center;
      transform-origin: center;
    }

    .door__content {
      height: 31.25rem;
      min-height: 31.25rem;
      padding-top: 6.875rem;
    }

    .door {
      height: 31.25rem;
    }

    .two-doors__rail {
      flex-direction: column;
      align-items: flex-start;
      padding-block: 1.75rem;
    }

    .two-doors__proof {
      width: 100%;
      grid-template-columns: 1fr 1fr;
      row-gap: 1.25rem;
    }
  }
</style>
