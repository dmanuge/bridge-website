---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  id?: string;
  level?: 2 | 3;
  theme?: "light" | "dark";
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  id,
  level = 2,
  theme = "light",
  class: className,
} = Astro.props;
const Heading = `h${level}` as const;
---

<div
  class:list={[
    "section-heading",
    theme === "dark" && "section-heading--dark",
    className,
  ]}
>
  <p class="eyebrow">{eyebrow}</p>
  <Heading class="section-title" id={id}>{title}</Heading>
  {description && <p class="lede">{description}</p>}
</div>

<style>
  .section-heading {
    max-width: 60ch;
  }

  .section-heading .section-title {
    margin-top: 0;
  }

  .section-heading--dark .eyebrow {
    color: var(--text-inverse-muted);
  }

  .section-heading--dark .section-title {
    color: var(--text-inverse);
  }

  .section-heading--dark .lede {
    color: var(--inverse-72);
  }
</style>
