---
/**
 * Shared post-hero homepage body. Keep this in sync with the production homepage.
 */
import FinalCta from "@/components/FinalCta.astro";
import ProcessSteps from "@/components/ProcessSteps.astro";
import ResponsiveImage from "@/components/ResponsiveImage.astro";
import ResultsLedger from "@/components/ResultsLedger.astro";
import { paths, results, stories } from "@/data/site";

interface PathDoorImage {
  src: string;
  alt: string;
}

interface Props {
  /** Optional override for the two "What we finance" door images (left, right). */
  pathDoorImages?: PathDoorImage[];
}

const defaultPathDoorImages: PathDoorImage[] = [
  {
    src: "/images/two-doors/1f8217b8-4668-4789-b359-dfe0461e6373.png",
    alt: "European hotel streetscape illustration",
  },
  {
    src: "/images/two-doors/call_1svIn8t98wTq4Hha0anEes8i.png",
    alt: "Consumer brand operator packing boxes in a warehouse",
  },
];

const { pathDoorImages = defaultPathDoorImages } = Astro.props;

const featuredStory = stories[0]!;
const processResult = results[1]!;
const pathDescriptions = [
  "Direct lending for new construction and PIPs. Expert-led financing execution for other hotel needs.",
  "Direct financing for inventory, orders, receivables, working capital and acquisitions.",
];
const featuredQuote = featuredStory.quote.split(".")[0] + ".";
---

<section class="doors-section" aria-labelledby="paths-title">
  <div class="doors-section__intro">
    <p class="two-doors-kicker">What we finance</p>
    <h2 id="paths-title">Two kinds of builders.</h2>
  </div>
  {
    paths.map((path, index) => (
      <article class="path-door">
        <ResponsiveImage
          class="path-door__image"
          src={pathDoorImages[index]!.src}
          alt={pathDoorImages[index]!.alt}
          width={1600}
          height={1000}
          sizes="(max-width: 900px) 100vw, 50vw"
        />
        <div class="path-door__overlay" />
        <div class="path-door__content">
          <h3>{path.title}</h3>
          <p>{pathDescriptions[index]}</p>
          <a href={`/${path.slug}`}>Explore {path.title} →</a>
        </div>
      </article>
    ))
  }
</section>

<section class="two-doors-section successes" aria-labelledby="successes-title">
  <p class="two-doors-kicker">Successes</p>
  <h2 id="successes-title">Financed.</h2>
  <p class="two-doors-subtitle">
    Real businesses. Real results. Capital provided and secured by Bridge.
  </p>
  <ResultsLedger results={results} />
</section>

<section
  class="two-doors-section process-section"
  aria-labelledby="process-title"
>
  <div class="process-section__copy">
    <p class="two-doors-kicker">How it works</p>
    <h2 id="process-title">From opportunity to funded progress.</h2>
    <p class="two-doors-subtitle">
      Bridge provides and secures financing so you can move forward with
      confidence.
    </p>
    <ProcessSteps />
  </div>

  <article class="process-card" aria-label="Recent hotel financing">
    <ResponsiveImage
      class="process-card__image"
      src="/images/two-doors/two-doors-room.jpg"
      alt="Renovated select-service hotel room"
      width={800}
      height={500}
      sizes="(max-width: 900px) 100vw, 38vw"
    />
    <div class="process-card__body">
      <p class="process-card__statement">{processResult.detail}.</p>
      <p class="process-card__attribution">Recent hotel financing</p>
      <div class="process-card__result">
        <p class="two-doors-kicker">{processResult.category}</p>
        <strong>{processResult.result}</strong>
        <span>{processResult.role}</span>
      </div>
    </div>
  </article>
</section>

<section class="documentary" aria-labelledby="story-title">
  <div class="documentary__content">
    <p class="two-doors-kicker">Customer story</p>
    <h2 id="story-title">“{featuredQuote}”</h2>
    <p class="documentary__attribution">
      {featuredStory.name}<br />
      <span>{featuredStory.title} · {featuredStory.company}</span>
    </p>
    <div class="documentary__result">
      <p class="two-doors-kicker">{featuredStory.financingType}</p>
      <strong>{featuredStory.result}</strong>
      <span>{featuredStory.role}</span>
      <a href={`/success-stories/${featuredStory.slug}`}>
        Read {featuredStory.name.split(" ")[0]}’s story →
      </a>
    </div>
  </div>
  <ResponsiveImage
    class="documentary__image"
    src="/images/brand/customer-story-founder.png"
    alt="Consumer brand founder working in a warehouse"
    width={1600}
    height={1000}
    sizes="(max-width: 900px) 100vw, 43vw"
    loading="eager"
  />
</section>

<FinalCta source="homepage-closing" />

<style>
  .two-doors-kicker {
    margin: 0;
    color: var(--slate-600);
    font-size: 0.625rem;
    font-weight: 640;
    letter-spacing: 0.24em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .two-doors-section {
    padding: var(--section-space-compact) var(--gutter);
  }

  .two-doors-section h2,
  .doors-section h2 {
    margin: 0.75rem 0;
    color: var(--ink-900);
    font-size: clamp(2rem, 3.6vw, 3rem);
    font-weight: 570;
    letter-spacing: -0.014em;
    line-height: 1.06;
  }

  .two-doors-subtitle {
    max-width: 60ch;
    margin: 0;
    color: var(--slate-600);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .doors-section {
    display: grid;
    min-height: 38.5625rem;
    padding: var(--section-space-compact) var(--gutter);
    background: var(--ivory-50);
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .doors-section__intro {
    max-width: 62ch;
    grid-column: 1 / -1;
  }

  .path-door {
    position: relative;
    display: flex;
    min-height: 20.625rem;
    overflow: hidden;
    align-items: flex-end;
    border-radius: 0.5rem;
    padding: 1.875rem;
    color: var(--text-inverse);
  }

  :global(.path-door__image),
  :global(.path-door__image img),
  .path-door__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  :global(.path-door__image img) {
    object-fit: cover;
  }

  .path-door__overlay {
    background: linear-gradient(
      180deg,
      var(--navy-overlay-14) 0%,
      var(--navy-overlay-42) 48%,
      var(--navy-overlay-90) 100%
    );
  }

  .path-door__content {
    position: relative;
    z-index: 1;
  }

  .path-door h3 {
    margin: 0 0 0.625rem;
    font-size: clamp(1.4375rem, 2.2vw, 1.875rem);
    font-weight: 650;
    letter-spacing: -0.018em;
    line-height: 1.12;
  }

  .path-door p {
    max-width: 40ch;
    margin: 0 0 1.125rem;
    color: var(--inverse-82);
    font-size: 0.90625rem;
    line-height: 1.6;
  }

  .path-door a {
    color: var(--text-inverse);
    font-size: 0.8125rem;
    font-weight: 620;
    text-decoration: none;
  }

  .path-door a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .successes {
    background: var(--white);
  }

  .successes h2 {
    margin-bottom: 0.25rem;
  }

  .process-section {
    display: grid;
    align-items: start;
    background: var(--ivory-50);
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.5rem, 3.5vw, 3.25rem);
  }

  .process-card {
    height: 22.1875rem;
    overflow: hidden;
    border: 1px solid var(--line-200);
    border-radius: 0.5rem;
    background: var(--white);
  }

  :global(.process-card__image) {
    display: block;
    height: 9.375rem;
  }

  :global(.process-card__image img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .process-card__body {
    padding: 1.375rem 1.5rem 1.5rem;
  }

  .process-card__statement {
    margin: 0 0 0.75rem;
    color: var(--ink-900);
    font-family: var(--font-display);
    font-size: 1.09375rem;
    font-style: italic;
    line-height: 1.32;
  }

  .process-card__attribution,
  .documentary__attribution {
    margin: 0;
    color: var(--slate-600);
    font-size: 0.625rem;
    font-weight: 640;
    letter-spacing: 0.2em;
    line-height: 1.9;
    text-transform: uppercase;
  }

  .process-card__result {
    display: grid;
    align-items: baseline;
    border-top: 1px solid var(--line-200);
    margin-top: 0.875rem;
    padding-top: 0.875rem;
    grid-template-columns: 1fr;
    gap: 0.25rem 0.75rem;
  }

  .process-card__result .two-doors-kicker {
    color: var(--slate-600);
    grid-column: 1 / -1;
  }

  .process-card__result strong {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 580;
  }

  .process-card__result span {
    display: block;
    color: var(--slate-600);
    font-size: 0.625rem;
    font-weight: 680;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .documentary {
    display: grid;
    min-height: 33.6875rem;
    background: var(--navy-950);
    color: var(--text-inverse);
    grid-template-columns: 1.15fr 0.85fr;
  }

  .documentary__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2.5rem, 5vw, 4.25rem) clamp(1.5rem, 3.2vw, 3.25rem);
  }

  .documentary .two-doors-kicker {
    color: var(--steel-light);
  }

  .documentary h2 {
    max-width: 22ch;
    margin: 0.875rem 0 1.125rem;
    color: var(--white);
    font-size: clamp(1.5rem, 2.8vw, 2.25rem);
    font-style: italic;
    font-weight: 480;
    letter-spacing: -0.006em;
    line-height: 1.32;
  }

  .documentary__attribution {
    color: var(--steel-light);
    letter-spacing: 0.18em;
  }

  .documentary__result {
    display: grid;
    border-top: 1px solid var(--inverse-20);
    margin-top: 1.875rem;
    padding-top: 1.375rem;
  }

  .documentary__result strong {
    margin: 0.375rem 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    font-weight: 580;
    line-height: 1.04;
  }

  .documentary__result span {
    color: var(--steel-light);
    font-size: 0.625rem;
    font-weight: 680;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .documentary__result a {
    margin-top: 1.25rem;
    color: var(--text-inverse);
    font-size: 0.8125rem;
    font-weight: 620;
    text-decoration: none;
  }

  :global(.documentary__image) {
    display: block;
    height: 100%;
    min-height: 26.25rem;
  }

  :global(.documentary__image img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 36%;
  }

  @media (max-width: 56.25rem) {
    .doors-section,
    .process-section,
    .documentary {
      grid-template-columns: 1fr;
    }

    .path-door {
      min-height: 20.625rem;
    }

    .doors-section,
    .documentary {
      min-height: 0;
    }

    .process-card {
      height: 20.75rem;
    }

    :global(.documentary__image) {
      height: 18.75rem;
      min-height: 18.75rem;
    }
  }

  @media (min-width: 37.5625rem) and (max-width: 56.25rem) {
    .doors-section {
      min-height: 56.8125rem;
    }

    .successes {
      min-height: 41rem;
    }

    .documentary__content {
      min-height: 27.5rem;
    }
  }

  @media (max-width: 36rem) {
    .doors-section,
    .two-doors-section {
      padding-inline: 1.25rem;
    }

    .path-door {
      min-height: 20.625rem;
      padding: 1.5rem;
    }

    .doors-section h2 {
      font-size: 1.875rem;
      white-space: nowrap;
    }

    .doors-section__intro {
      min-height: 4.5625rem;
    }

    .documentary__content {
      min-height: 26.5625rem;
    }

    .successes {
      padding-bottom: calc(var(--section-space-compact) - 2px);
    }

    .process-card {
      height: 23.625rem;
    }

    :global(.documentary__image) {
      height: 18.75rem;
      min-height: 18.75rem;
    }
  }
</style>
