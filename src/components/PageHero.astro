---
import ResponsiveImage from "@/components/ResponsiveImage.astro";

interface HeroImage {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  position?: string;
}

interface HeroVideo {
  src: string;
  poster?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  image?: HeroImage;
  video?: HeroVideo;
  variant?: "solid" | "image";
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  image,
  video,
  variant = image || video ? "image" : "solid",
  class: className,
} = Astro.props;
const hasMedia = Boolean(image || video);
const videoPoster = video?.poster ?? image?.src;
---

<header class:list={["page-hero", `page-hero--${variant}`, className]}>
  {
    video && (
      <video
        class="page-hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={videoPoster}
        aria-hidden="true"
      >
        <source src={video.src} type="video/mp4" />
      </video>
    )
  }
  {
    image && !video && (
      <ResponsiveImage
        class="page-hero__image"
        src={image.src}
        alt={image.alt}
        width={image.width ?? 1600}
        height={image.height ?? 1000}
        sizes="100vw"
        fetchpriority="high"
        style={`--hero-image-position: ${image.position ?? "center"}`}
      />
    )
  }
  {
    image && video && (
      <ResponsiveImage
        class="page-hero__image page-hero__image--fallback"
        src={image.src}
        alt={image.alt}
        width={image.width ?? 1600}
        height={image.height ?? 1000}
        sizes="100vw"
        style={`--hero-image-position: ${image.position ?? "center"}`}
      />
    )
  }
  {hasMedia && <div class="page-hero__overlay" />}
  <div class="container page-hero__content">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="display">{title}</h1>
    {description && <p class="page-hero__description">{description}</p>}
    <slot />
    <div class="page-hero__actions">
      <slot name="actions" />
    </div>
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    min-height: 31rem;
    overflow: hidden;
    background: var(--surface-brand);
    color: var(--text-inverse);
  }

  .page-hero--image {
    min-height: 43.125rem;
  }

  :global(.page-hero__image),
  .page-hero__video,
  .page-hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  :global(.page-hero__image img),
  .page-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-image-position, center);
  }

  .page-hero__video {
    z-index: 0;
    pointer-events: none;
  }

  :global(.page-hero__image--fallback) {
    display: none;
  }

  .page-hero__overlay {
    z-index: 1;
    background: linear-gradient(
      90deg,
      var(--navy-overlay-96) 0%,
      var(--navy-overlay-72) 48%,
      var(--navy-overlay-12) 100%
    );
  }

  @media (max-width: 48rem) {
    .page-hero--image .page-hero__overlay {
      background: linear-gradient(
        90deg,
        var(--navy-overlay-94),
        var(--navy-overlay-52)
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero__video {
      display: none;
    }

    :global(.page-hero__image--fallback) {
      display: block;
    }
  }

  .page-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: inherit;
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--section-space);
  }

  .page-hero__content :global(.eyebrow) {
    color: var(--text-inverse-muted);
  }

  .page-hero__content :global(.display),
  .page-hero__description {
    max-width: 46rem;
  }

  .page-hero__description {
    margin: 1.25rem 0 0;
    color: var(--inverse-78);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.6;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    margin-top: 2rem;
    gap: 0.75rem;
  }

  .page-hero__actions:empty {
    display: none;
  }
</style>
