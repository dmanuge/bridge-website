---
import ResponsiveImage from "@/components/ResponsiveImage.astro";

interface HeroImage {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  position?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  image?: HeroImage;
  variant?: "solid" | "image";
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  image,
  variant = image ? "image" : "solid",
  class: className,
} = Astro.props;
---

<header class:list={["page-hero", `page-hero--${variant}`, className]}>
  {
    image && (
      <ResponsiveImage
        class="page-hero__image"
        src={image.src}
        alt={image.alt}
        width={image.width ?? 1600}
        height={image.height ?? 1000}
        sizes="100vw"
        fetchpriority="high"
        style={`--hero-image-position: ${image.position ?? "center"}`}
      />
    )
  }
  {image && <div class="page-hero__overlay" />}
  <div class="container page-hero__content">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="display">{title}</h1>
    {description && <p class="page-hero__description">{description}</p>}
    <slot />
    <div class="page-hero__actions">
      <slot name="actions" />
    </div>
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    min-height: 31rem;
    overflow: hidden;
    background: var(--surface-brand);
    color: var(--text-inverse);
  }

  .page-hero--image {
    min-height: 43.125rem;
  }

  :global(.page-hero__image),
  .page-hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  :global(.page-hero__image img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-image-position);
  }

  .page-hero__overlay {
    background: linear-gradient(
      90deg,
      var(--navy-overlay-96) 0%,
      var(--navy-overlay-72) 48%,
      var(--navy-overlay-12) 100%
    );
  }

  .page-hero__content {
    position: relative;
    display: flex;
    min-height: inherit;
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--section-space);
  }

  .page-hero__content :global(.eyebrow) {
    color: var(--text-inverse-muted);
  }

  .page-hero__content :global(.display),
  .page-hero__description {
    max-width: 46rem;
  }

  .page-hero__description {
    margin: 1.25rem 0 0;
    color: var(--inverse-78);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.6;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    margin-top: 2rem;
    gap: 0.75rem;
  }

  .page-hero__actions:empty {
    display: none;
  }

  @media (max-width: 48rem) {
    .page-hero--image .page-hero__overlay {
      background: linear-gradient(
        90deg,
        var(--navy-overlay-94),
        var(--navy-overlay-52)
      );
    }
  }
</style>
