---
import type { FinancingResult } from "@/data/site";
import ResponsiveImage from "@/components/ResponsiveImage.astro";

interface Props {
  results: FinancingResult[];
  limit?: number;
}

const { results, limit } = Astro.props;
const visibleResults =
  typeof limit === "number" ? results.slice(0, limit) : results;
---

<div class="ledger">
  <div class="ledger__header" aria-hidden="true">
    <span></span>
    <span>Financing</span>
    <span>Amount</span>
    <span>Bridge’s role</span>
    <span>Status</span>
    <span></span>
  </div>
  {
    visibleResults.map((result) => (
      <article class="ledger__row">
        <ResponsiveImage
          class="ledger__image"
          src={result.image}
          alt=""
          width={800}
          height={500}
          sizes="56px"
        />
        <h3>{result.category}</h3>
        <p class="ledger__amount" data-label="Result">
          {result.result}
        </p>
        <p class="ledger__role" data-label="Bridge’s role">
          {result.role}
        </p>
        <p
          class={`ledger__status ledger__status--${result.status.toLowerCase().replace(" ", "-")}`}
          data-label="Status"
        >
          <span aria-hidden="true" /> {result.status}
        </p>
        <a
          class="ledger__arrow"
          href="/success-stories"
          aria-label={`View financing successes including ${result.category}`}
        >
          →
        </a>
      </article>
    ))
  }
</div>

<style>
  .ledger {
    overflow-x: auto;
    margin-top: 2.0625rem;
  }

  .ledger__header,
  .ledger__row {
    display: grid;
    min-width: 45rem;
    align-items: center;
    grid-template-columns: 3.5rem 1.45fr 0.8fr 1.05fr 0.95fr 1.625rem;
    gap: 1.25rem;
  }

  .ledger__header {
    height: 2.5rem;
    padding: 1rem 0 0.625rem;
    color: var(--text-secondary);
    font-size: 0.59375rem;
    font-weight: 640;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .ledger__row {
    height: 4.5625rem;
    overflow: hidden;
    border-top: var(--border-hairline);
    padding: 1rem 0;
  }

  :global(.ledger__image) {
    width: 3.5rem;
    height: 2.5rem;
  }

  :global(.ledger__image img) {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-sm);
    object-fit: cover;
  }

  .ledger h3,
  .ledger p {
    margin: 0;
  }

  .ledger h3 {
    font-size: var(--type-body-small);
    font-weight: 640;
  }

  .ledger__amount {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .ledger__role,
  .ledger__status {
    color: var(--text-secondary-strong);
    font-size: 0.75rem;
  }

  .ledger__status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ledger__status span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--gold-500);
  }

  .ledger__status--funded span,
  .ledger__status--closed span {
    background: var(--success);
  }

  .ledger__arrow {
    display: inline-flex;
    color: var(--text-secondary);
    font-weight: 600;
    text-decoration: none;
  }
</style>
