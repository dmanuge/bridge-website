---
import HomepageContent from "@/components/HomepageContent.astro";
import ResponsiveImage from "@/components/ResponsiveImage.astro";
import { getPath } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const hotel = getPath("hotel-financing");
const heroVideo = hotel.heroVideo!;
const heroImage = hotel.heroImage;
const heroAlt = hotel.heroAlt;
---

<BaseLayout
  title="Bricks to Brands"
  description={hotel.description}
  image={heroImage}
>
  <header class="v2-hero">
    <video
      class="v2-hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={heroImage}
      aria-hidden="true"
    >
      <source src={heroVideo} type="video/mp4" />
    </video>
    <ResponsiveImage
      class="v2-hero__fallback"
      src={heroImage}
      alt={heroAlt}
      width={1600}
      height={1000}
      sizes="100vw"
    />
    <div class="v2-hero__overlay"></div>
    <div class="v2-hero__content">
      <h1>Bricks to Brands</h1>
    </div>
  </header>

  <HomepageContent />
</BaseLayout>

<style>
  .v2-hero {
    position: relative;
    display: flex;
    min-height: 100svh;
    overflow: hidden;
    align-items: flex-end;
    justify-content: center;
    background: var(--surface-brand);
    color: var(--text-inverse);
  }

  .v2-hero__video,
  :global(.v2-hero__fallback),
  .v2-hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .v2-hero__video,
  :global(.v2-hero__fallback img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .v2-hero__video {
    z-index: 0;
    pointer-events: none;
  }

  :global(.v2-hero__fallback) {
    display: none;
  }

  .v2-hero__overlay {
    z-index: 1;
    background: linear-gradient(
      180deg,
      var(--navy-overlay-12) 0%,
      var(--navy-overlay-42) 48%,
      var(--navy-overlay-90) 100%
    );
  }

  .v2-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
    padding: 0 var(--gutter) clamp(2.5rem, 6vh, 4.5rem);
    text-align: center;
  }

  .v2-hero__content h1 {
    margin: 0;
    color: var(--white);
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    font-weight: 560;
    letter-spacing: -0.012em;
    line-height: 1.15;
  }

  @media (prefers-reduced-motion: reduce) {
    .v2-hero__video {
      display: none;
    }

    :global(.v2-hero__fallback) {
      display: block;
    }
  }
</style>
